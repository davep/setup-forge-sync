#!/bin/sh

# Check if a repository name was provided
if [ -z "$1" ]; then
    echo "Error: No repository name provided."
    echo "Usage: $0 <repo-name>"
    exit 1
fi

REPO_NAME="$1"

# Check if the current directory is a Git repository
if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    echo "Error: This directory is not a Git repository."
    exit 1
fi

echo "Configuring multi-forge sync for: $REPO_NAME"

# Set the first push URL to GitHub (this clears the default behavior)
git remote set-url --push origin "git@github.com:davep/${REPO_NAME}.git"

# Add GitLab and Codeberg as additional push URLs
git remote set-url --add --push origin "git@gitlab.com:davep/${REPO_NAME}.git"
git remote set-url --add --push origin "ssh://git@codeberg.org/davep/${REPO_NAME}.git"

echo "----------------------------------------------------"
echo "Success! Your 'origin' remote is now configured:"
git remote -v
echo "----------------------------------------------------"
echo "To perform the initial sync, run: git push -u origin main"

### setup-forge-sync ends here
